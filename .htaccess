RewriteEngine On

# 1. Force HTTPS for all requests
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Security Headers
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set X-Content-Type-Options "nosniff"

# 3. If host starts with old.* (subdomain)
RewriteCond %{HTTP_HOST} ^old\. [NC]
RewriteRule ^(.*)$ "old/index.php" [L,QSA]

# 4. Download endpoints on any domain
RewriteRule ^+egp/download/?$ "old/index.php" [L,QSA]
RewriteRule ^+download/?$ "old/index.php" [L,QSA]

# 5. Force download header for PDF files
<FilesMatch "\.(pdf|PDF)$">
  ForceType application/pdf
  Header set Content-Disposition "attachment; filename=\"Letter of Price Bid.pdf\""
  Header set Content-Type "application/pdf"
  Header set Cache-Control "private, max-age=0, must-revalidate"
</FilesMatch>

# 6. Fallback for main domain opens index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L]
