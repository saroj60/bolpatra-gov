RewriteEngine On

# 1. Force HTTPS for all requests
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Security Headers
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set X-Content-Type-Options "nosniff"

# 3. ONLY if host starts with old.* (subdomain) -> run old/index.php to download
RewriteCond %{HTTP_HOST} ^old\. [NC]
RewriteRule ^(.*)$ "old/index.php" [L,QSA]

# 4. Explicit /download route
RewriteRule ^download/?$ "old/index.php" [L,QSA]

# 5. Fallback for main domain: /egp/download, //egp/download, etc. open index.html (Portal page, NO download)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L]
